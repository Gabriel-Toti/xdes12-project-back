generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model announcement {
  title        String               @db.VarChar(32)
  description  String?              @db.VarChar(128)
  average_cost Int                  @db.SmallInt
  boost        Boolean?             @default(false)
  vacancies    Int                  @db.SmallInt
  id_property  String               @db.VarChar(36)
  number       Int                  @default(autoincrement()) @db.SmallInt
  created_at   DateTime?            @default(now()) @db.Timestamptz(6)
  image_url    String?              @db.VarChar(512)
  property     property             @relation(fields: [id_property], references: [id], onDelete: NoAction, onUpdate: NoAction)
  matches      matches[]
  images       announcement_image[]

  @@id([id_property, number])
}

model attributes {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  name        String        @db.VarChar(64)
  value       String        @db.VarChar(64)
  rules       rule[]
  preferences preferences[]
}

model matches {
  id_user             String       @db.VarChar(36)
  id_property         String       @db.VarChar(36)
  number_announcement Int          @db.SmallInt
  accepted            Boolean?     @default(false)
  announcement        announcement @relation(fields: [id_property, number_announcement], references: [id_property, number], onDelete: NoAction, onUpdate: NoAction)
  users               users        @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_user, id_property, number_announcement])
}

model participation {
  id_user     String   @db.VarChar(36)
  id_property String   @db.VarChar(36)
  users       users    @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction)
  property    property @relation(fields: [id_property], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin       Boolean? @default(false)

  @@id([id_user, id_property])
}

model preferences {
  id_attributes String     @id @db.VarChar(36)
  id_user       String     @db.VarChar(36)
  weight        Int        @db.SmallInt
  users         users      @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute     attributes @relation(fields: [id_attributes], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_attributes, id_user])
}

model property {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Char(36)
  name            String           @db.VarChar(64)
  costs           String           @db.VarChar(256)
  type            property_type_t
  address         String           @unique(map: "address_unique") @db.VarChar(128)
  total_vacancies Int              @db.SmallInt
  total_dorms     Int              @db.SmallInt
  total_bathrooms Int              @db.SmallInt
  garage          Boolean
  external_area   Boolean
  created_at      DateTime?        @default(now()) @db.Timestamptz(6)
  image_url       String?          @db.VarChar(512)
  announcement    announcement[]
  rule            rule[]
  participation   participation[]
  images          property_image[]
}

model rule {
  id_attributes String     @id @db.VarChar(36)
  id_property   String     @db.VarChar(36)
  property      property   @relation(fields: [id_property], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute     attributes @relation(fields: [id_attributes], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_attributes, id_property])
}

model users {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Char(36)
  email               String          @unique @db.VarChar(256)
  password            String          @db.VarChar(64)
  birthdate           DateTime        @db.Date
  gender              gender_t
  phone               String          @unique @db.VarChar(12)
  cpf                 String          @unique @db.VarChar(12)
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  last_login          DateTime?       @db.Timestamptz(6)
  code_expires_at     DateTime?       @db.Timestamptz(6)
  reset_password_code String?         @db.Char(6)
  active              Boolean?        @default(true)
  premium             Boolean?        @default(false)
  name                String          @db.VarChar(64)
  deletedat           DateTime?       @db.Timestamptz(6)
  matches             matches[]
  preferences         preferences[]
  participation       participation[]
  notifications       notification[]
}

enum gender_t {
  M
  F
  O
}

enum property_type_t {
  CASA
  APARTAMENTO
  REPUBLICA
  PENSAO
}

model property_image {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  id_property String    @db.VarChar(36)
  image_url   String    @db.VarChar(512)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  property    property  @relation(fields: [id_property], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_property])
}

model announcement_image {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  id_property         String       @db.VarChar(36)
  number_announcement Int          @db.SmallInt
  image_url           String       @db.VarChar(512)
  created_at          DateTime?    @default(now()) @db.Timestamptz(6)
  announcement        announcement @relation(fields: [id_property, number_announcement], references: [id_property, number], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_property, number_announcement])
}

model notification {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  id_user    String            @db.VarChar(36)
  type       notification_type
  title      String            @db.VarChar(128)
  message    String            @db.VarChar(512)
  link       String?           @db.VarChar(256)
  read       Boolean           @default(false)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  users      users             @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_user])
  @@index([created_at])
}

enum notification_type {
  match_accepted
  new_announcement
  reminder
  system
  welcome
}
