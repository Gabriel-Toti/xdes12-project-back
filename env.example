# Server
SERVER_PORT=3333
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=altere-esta-chave
DATABASE_URL=postgresql://user:password@localhost:5432/casar

# Cookies (opcional para produção)
# COOKIE_DOMAIN=.seu-dominio.com

# Email SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu.email@gmail.com
SMTP_PASS=sua-senha-de-aplicativo
SMTP_FROM="CASAR <seu.email@gmail.com>"

